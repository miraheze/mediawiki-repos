+/*
+ * Citizen
+ *
+ * SkinStyles for Extension:Echo
+ * Module: ext.echo.ui.desktop
+ * Version: REL1_43 / REL1_45
+ *
+ * Date: 2025-12-23
+ *
+ * COMPAT (pre-v3.17.0 cached HTML only). See ext.echo.ui.less.
+ * Needs no gate: the selector requires a badge popup element, which only
+ * Echo's badge JS creates and only the cached portlet boots.
+*/
+
+.mw-echo-ui-notificationBadgeButtonPopupWidget-popup,
+.mw-echo-ui-notificationBadgeController-popup {
+	> .oo-ui-popupWidget-anchor {
+		display: none; // the anchor overflow the viewport
+	}
+}
diff --git a/skinStyles/extensions/Echo/ext.echo.ui.less b/skinStyles/extensions/Echo/ext.echo.ui.less
new file mode 100644
index 00000000..3d59c13d
--- /dev/null
+++ b/skinStyles/extensions/Echo/ext.echo.ui.less
@@ -0,0 +1,232 @@
+/*
+ * Citizen
+ *
+ * SkinStyles for Extension:Echo
+ * Module: ext.echo.ui
+ * Version: REL1_43 / REL1_45
+ *
+ * Date: 2025-12-23
+ *
+ * COMPAT (pre-v3.17.0 cached HTML only).
+ * Deleted by v3.17.0 (9009de10) along with Echo's badges. Cached pre-v3.17.0
+ * HTML still boots Echo's badge JS, which builds the popup inside
+ * `.mw-echo-ui-overlay` -- a zero-height element Echo positions from the top.
+ * Without the overrides below the popup hangs off the bottom of the viewport
+ * and only its first rows are reachable.
+ *
+ * SUPPRESSION ON NEW HTML.
+ * `ext.echo.ui` is not badge-only: `ext.echo.special` depends on it, so this
+ * file also loads on Special:Notifications, where post-v3.17.0 HTML *does*
+ * carry `.mw-echo-ui-overlay` and (once the user has notifications)
+ * `.mw-echo-ui-notificationItemWidget`. Those three blocks are therefore gated
+ * on @old-notifications-portlet below. The rest of the file needs no gate --
+ * it is structurally unreachable on new HTML, see the notes at each block.
+ *
+ * The gate is wrapped in `:where()` so it contributes ZERO specificity. A bare
+ * `body:has( #p-notifications )` would add (1,0,1) and quietly promote every
+ * gated rule above overrides that currently beat it -- a (0,1,0) rule in
+ * MediaWiki:Citizen.css wins today and must keep winning. `:where()` makes the
+ * gate a pure matching filter: same specificity as the original rule, same
+ * cascade, just fewer pages matched. Do not "simplify" it away.
+*/
+
+@import '../../../resources/variables.less';
+@import '../../../resources/mixins.less';
+
+// Old-HTML gate. `#p-notifications` is Echo's badge portlet, rendered through
+// Menu.mustache up to v3.16.1. v3.17.0's SkinHooks::updateNotificationsMenu
+// unsets `$links['notifications']` wholesale and Header.mustache renders
+// Notifications.mustache instead, so no post-v3.17.0 page emits the portlet --
+// its presence *is* the generation test. Preferred over a root marker
+// (AGENTS.md "Preferred: a local discriminator"); it also needs no marker
+// stamped on `<html>`, which this branch does not have.
+@old-notifications-portlet: ~':where( body:has( #p-notifications ) )';
+
+// Ungated: `pt-talk-alert` is an *item inside* the notifications portlet
+// (Echo Hooks.php sets `$links['notifications']['talk-alert']`), so v3.17.0's
+// unset drops it from new HTML along with the badges. Self-gating.
+#pt-talk-alert {
+	display: none;
+}
+
+// Ungated: the whole selector needs a badge popup element, which only Echo's
+// badge JS creates and only the cached portlet boots. Special:Notifications
+// builds an inbox, not a popup.
+.skin-citizen {
+	.mw-echo-ui-notificationBadgeButtonPopupWidget-popup,
+	.mw-echo-ui-notificationBadgeController-popup {
+		top: unset !important;
+		bottom: calc( var( --header-size-block-end ) + env( safe-area-inset-bottom ) ) !important;
+		margin: var( --space-xs );
+		box-shadow: var( --box-shadow-large );
+
+		@media ( min-width: @min-width-breakpoint-desktop ) {
+			.citizen-header-position-left & {
+				right: unset !important;
+				bottom: 0 !important;
+				left: var( --header-size-inline-start ) !important;
+			}
+
+			.citizen-header-position-right & {
+				right: var( --header-size-inline-end ) !important;
+				bottom: 0 !important;
+				left: unset !important;
+			}
+
+			.citizen-header-position-top & {
+				top: var( --header-size-block-start ) !important;
+				right: 0 !important;
+				bottom: unset !important;
+				left: unset !important;
+			}
+
+			.citizen-header-position-bottom & {
+				right: 0 !important;
+				bottom: var( --header-size-block-end ) !important;
+				left: unset !important;
+			}
+		}
+
+		.oo-ui-popupWidget-body {
+			height: auto !important;
+			max-height: ~'calc( var( --header-card-maxheight ) - 2 * 3.1428571em )'; // 3.1428571em = height of .oo-ui-popupWidget-head & .oo-ui-popupWidget-footer
+		}
+
+		> .oo-ui-popupWidget-popup {
+			> .oo-ui-popupWidget-head {
+				display: flex;
+				align-items: center;
+				height: auto;
+				min-height: @size-300;
+				padding-inline: var( --space-md );
+				background: var( --color-surface-1 );
+				border-bottom-color: transparent;
+
+				> .oo-ui-iconWidget {
+					float: none;
+					margin: 0;
+				}
+
+				> .oo-ui-labelElement-label {
+					flex-grow: 1;
+					margin-left: var( --space-xs );
+					font-size: var( --font-size-medium );
+					font-weight: var( --font-weight-semi-bold );
+					line-height: var( --line-height-small );
+					color: var( --color-emphasized );
+				}
+
+				.mw-echo-ui-notificationsWidget-markAllReadButton {
+					position: relative;
+					margin: 0;
+				}
+			}
+		}
+	}
+}
+
+/* mw.echo.ui.mobile.less */
+@media all and ( max-width: 720px ) {
+	@{old-notifications-portlet} .mw-echo-ui-overlay {
+		.mw-echo-ui-notificationBadgeButtonPopupWidget-popup,
+		.mw-echo-ui-notificationBadgeController-popup {
+			right: 0 !important;
+			left: 0 !important;
+		}
+	}
+}
+
+/* mw.echo.ui.overlay.less */
+// Gated: Special:Notifications carries `.mw-echo-ui-overlay` on new HTML too,
+// where Echo's own `position: absolute` is correct and this block's
+// `fixed`/`bottom: 0` is not.
+@{old-notifications-portlet} .mw-echo-ui-overlay {
+	position: fixed; // Header is fixed
+	// The notification button is always bottom-aligned
+	// Setting a top value will break the 0 height hack used in the original
+	top: unset;
+	bottom: 0;
+	z-index: @z-index-overlay; // Higher than header
+
+	@media ( min-width: @min-width-breakpoint-desktop ) {
+		.citizen-header-position-top & {
+			top: 0;
+			bottom: unset;
+		}
+	}
+
+	// Add dismiss affordnance backdrop
+	@media ( max-width: @max-width-breakpoint-tablet ) {
+		&::before {
+			content: '';
+			background: var( --background-color-backdrop-light );
+			opacity: 0;
+			-webkit-backdrop-filter: var( --backdrop-filter-blur );
+			backdrop-filter: var( --backdrop-filter-blur );
+			transition-timing-function: var( --transition-timing-function-ease );
+			transition-duration: var( --transition-duration-base );
+			transition-property: opacity;
+		}
+
+		&:has( > :is( .mw-echo-ui-notificationBadgeButtonPopupWidget-popup, .mw-echo-ui-notificationBadgeController-popup ):not( .oo-ui-element-hidden ) ) {
+			&::before {
+				position: fixed;
+				inset: 0;
+				opacity: 1;
+				transition-duration: var( --transition-duration-medium );
+			}
+		}
+	}
+}
+
+// Gated: both widgets also render in Special:Notifications' inbox on new HTML.
+// Wrapped rather than prefixed per block, so the `&-suffix` concatenations
+// below still resolve against the widget class (a wrapper appends to the last
+// compound of the parent chain, which is what the original relied on).
+@{old-notifications-portlet} {
+	/* mw.echo.ui.PlaceholderItemWidget.less */
+	.mw-echo-ui-placeholderItemWidget {
+		display: grid;
+		place-content: center;
+		min-height: @size-800;
+		padding: var( --space-sm ) var( --space-md );
+		color: var( --color-subtle );
+		text-align: center;
+		background-color: transparent;
+	}
+
+	/* mw.echo.ui.NotificationItemWidget.less */
+	.mw-echo-ui-notificationItemWidget {
+		padding: var( --space-sm ) var( --space-md );
+		background-color: transparent;
+
+		&-unread {
+			background-color: var( --color-surface-2 );
+		}
+
+		&-icon {
+			img {
+				width: 20px;
+				// Sync with icon above
+				height: 20px;
+			}
+		}
+
+		&-content {
+			padding-left: var( --space-sm );
+			margin-left: 20px;
+
+			&-actions {
+				margin-top: var( --space-xs );
+				font-size: var( --font-size-small );
+
+				&-timestamp {
+					font-size: inherit;
+					line-height: var( --line-height-sm ) !important;
+					color: var( --color-subtle );
+					opacity: 1;
+				}
+			}
+		}
+	}
+}
