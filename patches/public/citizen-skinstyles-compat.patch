diff --git a/skinStyles/extensions/Echo/ext.echo.styles.alert.less b/skinStyles/extensions/Echo/ext.echo.styles.alert.less
new file mode 100644
index 00000000..03fc24f3
--- /dev/null
+++ b/skinStyles/extensions/Echo/ext.echo.styles.alert.less
@@ -0,0 +1,43 @@
+/*
+ * Citizen
+ *
+ * SkinStyles for Extension:Echo
+ * Module: ext.echo.styles.alert
+ * Version: REL1_43
+ *
+ * Date: 2025-01-04
+ *
+ * COMPAT (pre-v3.17.0 cached HTML only).
+ * Deleted by v3.17.0 (9009de10) with the rest of the Echo skinStyles.
+ * `.mw-echo-alert` is the new-messages bar, and Echo hangs it off the
+ * notifications portlet (`$links['notifications']['talk-alert']` in Echo's
+ * Hooks.php) -- so v3.17.0's `unset( $links['notifications'] )` drops it from
+ * new HTML along with the badges. Needs no gate: the element cannot exist on a
+ * post-v3.17.0 page.
+*/
+
+@import '../../../resources/variables.less';
+
+/* Sync styles with mw.notifications */
+.mw-echo-alert {
+	position: fixed;
+	top: 0;
+	right: 0;
+	z-index: @z-index-overlay;
+	max-width: 80vw;
+	padding: 0;
+	margin: var( --space-xs );
+	font-size: var( --font-size-small );
+	line-height: var( --line-height-small );
+	color: var( --color-base );
+	background-color: var( --background-color-warning-subtle );
+	border: var( --border-width-base ) solid var( --border-color-base );
+	border-radius: var( --border-radius-medium );
+	box-shadow: var( --box-shadow-large );
+
+	// Needed additional specificity
+	.citizen-menu &.mw-list-item > a {
+		padding: var( --space-sm ) var( --space-md );
+		border-radius: var( --border-radius-large );
+	}
+}
diff --git a/skinStyles/extensions/Echo/ext.echo.styles.badge.less b/skinStyles/extensions/Echo/ext.echo.styles.badge.less
new file mode 100644
index 00000000..12fb2dad
--- /dev/null
+++ b/skinStyles/extensions/Echo/ext.echo.styles.badge.less
@@ -0,0 +1,88 @@
+/*
+ * Citizen
+ *
+ * SkinStyles for Extension:Echo
+ * Module: ext.echo.styles.badge
+ * Version: REL1_43
+ *
+ * Date: 2025-01-04
+ *
+ * COMPAT (pre-v3.17.0 cached HTML only).
+ * v3.17.0 (9009de10) replaced Echo's two badges with Citizen's own bell
+ * dropdown and deleted this file. Cached HTML rendered before that upgrade
+ * still carries Echo's portlet, whose anchors Citizen's old
+ * SkinHooks::updateNotificationsMenu stamped with
+ * `citizen-echo-notification-badge` *instead of* Echo's own
+ * `mw-echo-notifications-badge` -- so neither this file nor Echo's own
+ * nojs/mw.echo.badge.less styles them once this is gone, and the label
+ * ("Alerts (0)") renders as plain text. On MW 1.45+ Echo's
+ * BadgeLinkController enhances that anchor in place rather than rebuilding
+ * it, so the old classes -- and the breakage -- survive the JS upgrade.
+ * Inert against post-v3.17.0 HTML, which has no `.citizen-echo-notification-badge`.
+ * Delete once no cache can still hold pre-v3.17.0 HTML.
+ *
+ * Deviation from the original: registered in skin.json as `+ext.echo.styles.badge`
+ * (additive) rather than a wholesale replacement. The replacement was safe only
+ * while skins.citizen.scripts/echo.js re-applied Citizen's classes after Echo
+ * rebuilt the badge; that file went with the same commit. On MW 1.43/1.44, where
+ * Echo still rebuilds the anchor with its own classes, keeping Echo's base badge
+ * styles is what stops the rebuilt badge from falling back to bare text.
+*/
+
+@import '../../../resources/mixins.less';
+
+.citizen-echo-notification-badge {
+	position: relative;
+
+	&.cdx-button.cdx-button--icon-only {
+		gap: 0;
+		min-height: 40px;
+		padding-inline: 0;
+	}
+
+	// Icon rendering via CSS-only approach, activated after echo.js adds the
+	// icon class (mw-ui-icon-wikimedia-*) to the anchor.
+	// Echo replaces anchor children on every update, so icon spans cannot persist.
+	// The mask-image is provided by skins.citizen.icons (OOUIIconPackModule).
+	&[ class*='mw-ui-icon-wikimedia-' ] {
+		// Hide Echo's text content — only the icon (::before) should be visible
+		font-size: 0;
+
+		&::before {
+			display: block;
+			width: var( --size-icon );
+			height: var( --size-icon );
+			content: '';
+			background-color: currentcolor;
+			-webkit-mask-repeat: no-repeat;
+			mask-repeat: no-repeat;
+			-webkit-mask-position: center;
+			mask-position: center;
+			-webkit-mask-size: contain;
+			mask-size: contain;
+		}
+	}
+
+	// Badge dot for unread notifications
+	&:not( [ data-counter-text='0' ] )::after {
+		position: absolute;
+		top: var( --space-xxs );
+		right: var( --space-xxs );
+		box-sizing: content-box;
+		width: 0.5rem;
+		height: 0.5rem;
+		content: '';
+		background: var( --color-progressive );
+		border: 4px solid var( --color-surface-0 );
+		border-radius: var( --border-radius-circle );
+
+		#pt-notifications-alert & {
+			background: var( --color-destructive );
+		}
+	}
+
+	// Hide text label — screen-reader only in both JS and no-JS modes
+	> span:last-child {
+		.mixin-citizen-screen-reader-only;
+	}
+}
diff --git a/skinStyles/extensions/Echo/ext.echo.ui.desktop.less b/skinStyles/extensions/Echo/ext.echo.ui.desktop.less
