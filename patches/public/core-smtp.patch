From ff4273309116c873231fb903f68fa39acb41b830 Mon Sep 17 00:00:00 2001
From: Universal Omega <1010delta1010@gmail.com>
Date: Wed, 18 Nov 2026 20:22:14 -0700
Subject: [PATCH] UserMailer: Honor $wgSMTP['localhost'] as the EHLO name

The PEAR based mailer passed the 'localhost' key of $wgSMTP to
Net_SMTP, where it is used as the argument to EHLO. When the mailer
moved to Symfony Mailer, getSmtpTransport() stopped reading it, so
every message is now sent with Symfony's default of [127.0.0.1].

Some relays reject that name. Google's SMTP relay answers the EHLO
with "421 4.7.0 Try again later, closing connection", so mail fails
for any wiki that relied on 'localhost' to set a valid name.

Pass the configured value to EsmtpTransport::setLocalDomain(). When
the key is unset the Symfony default is kept.

Bug: T445187
Change-Id: I33d71b56bce74db1a6431058cebea7435c8a42bb
---

diff --git a/includes/Mail/UserMailer.php b/includes/Mail/UserMailer.php
index bebe246..dc26182 100644
--- a/includes/Mail/UserMailer.php
+++ b/includes/Mail/UserMailer.php
@@ -59,6 +59,11 @@
 
 		$transport = new EsmtpTransport( $host, $port, $tls );
 
+		// Used as the EHLO name. T445187
+		if ( !empty( $smtp['localhost'] ) ) {
+			$transport->setLocalDomain( $smtp['localhost'] );
+		}
+
 		if ( !empty( $smtp['auth'] ) ) {
 			$transport->setUsername( $smtp['username'] ?? '' );
 			$transport->setPassword( $smtp['password'] ?? '' );
diff --git a/tests/phpunit/unit/includes/Mail/UserMailerTest.php b/tests/phpunit/unit/includes/Mail/UserMailerTest.php
index 8a1e98b..21e4e6f 100644
--- a/tests/phpunit/unit/includes/Mail/UserMailerTest.php
+++ b/tests/phpunit/unit/includes/Mail/UserMailerTest.php
@@ -247,4 +247,22 @@
 			],
 		];
 	}
+
+	public function testGetSmtpTransportUsesLocalhostAsEhloName() {
+		$transport = TestingAccessWrapper::newFromClass( UserMailer::class )
+			->getSmtpTransport( [
+				'host' => 'smtp.example.org',
+				'port' => 25,
+				'localhost' => 'wiki.example.org',
+			] );
+
+		$this->assertSame( 'wiki.example.org', $transport->getLocalDomain() );
+	}
+
+	public function testGetSmtpTransportDefaultsEhloNameWithoutLocalhost() {
+		$transport = TestingAccessWrapper::newFromClass( UserMailer::class )
+			->getSmtpTransport( [ 'host' => 'smtp.example.org' ] );
+
+		$this->assertNotSame( '', $transport->getLocalDomain() );
+	}
 }
